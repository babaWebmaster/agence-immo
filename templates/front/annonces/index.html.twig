{% import 'front/macros/form.html.twig' as formMacro %}
{% extends '/front/base.html.twig' %}


{% block body %}



<section class="hero {% if classHero is defined %}{{classHero}} {%endif%}">


   {% if image_hero is defined and image_hero is not empty %}
        {{ image_hero|raw }}
    {% endif %}
   
     <button class="hero__btn-form" type="button" aria-controls="menu-search-annonce" aria-expanded="true">
        <span class="hero__btn-svg">
        <svg xmlns="http://www.w3.org/2000/svg"
        width="20" height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round">
        <line x1="21" x2="14" y1="4" y2="4"/>
        <line x1="10" x2="3" y1="4" y2="4"/>
        <line x1="21" x2="12" y1="12" y2="12"/>
        <line x1="8" x2="3" y1="12" y2="12"/>
        <line x1="21" x2="16" y1="20" y2="20"/>
        <line x1="12" x2="3" y1="20" y2="20"/>
        <line x1="14" x2="14" y1="2" y2="6"/>
        <line x1="8" x2="8" y1="10" y2="14"/>
        <line x1="16" x2="16" y1="18" y2="22"/>
        </svg>
        </span> 
        <span class="hero__btn-label">Recherchez un bien</span>

    </button>
    <div class="hero__wrapper-form_title" id="menu-search-annonce">
       
        <h1 class="hero__title">AGENCE BAES À HOUILLES - Nos bien à louer</h1>
       

    {% include 'front/annonces/_formSearch.html.twig' %}


    

    
            
    </div>
     <svg class="hero__svg-annonce"  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 0 0">

        <defs>
       
            <linearGradient id="heroFade" x1="0%" y1="100%" x2="0%" y2="0%">
                
                <stop offset="0%" stop-color="#173B5F" stop-opacity="0.9" />
                
                
                <stop offset="80%" stop-color="#173B5F" stop-opacity="1" />
            </linearGradient>
        </defs>

        <defs>
       
            <linearGradient id="heroFadeMobile" x1="0%" y1="0%" x2="0%" y2="100%">
                
                <stop offset="0%" stop-color="#173B5F" stop-opacity="0.9" />
                
                
                <stop offset="80%" stop-color="#173B5F" stop-opacity="1" />
            </linearGradient>
        </defs>

        <path d="M 0 0 H 400 V 400 H 0 C 100 300 100 100 0 0 Z
            "          
        />
    </svg>

</section>

<section class="annonces d-flex flex-column">
{% if annonces is defined and annonces is not null %}
            {{ annonces|raw }}
{% endif %}


</section>
{% endblock %}

