{% import 'front/macros/loaderImg.html.twig' as loaderImg %}
{% extends '/front/base.html.twig' %}


{% block body %}

    <section class="hero">
          
          {% include 'front/annonce/_slider.html.twig' %}

          <div class="hero__annonce-intro">           
            <svg class="hero__svg " xmlns="http://www.w3.org/2000/svg" viewBox="-600 0 600 550">
             <defs>
                <linearGradient id="heroGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#173B5F" />
                    <stop offset="100%" stop-color="#2D638A" />
                </linearGradient>
            </defs>


          <path fill="url(#heroGradient)" d="M 0 0 H -574.13330078125 C -580 200 -600 400 -574 450 C -400 550 -200 480 0 450 H 0 V 0 Z"></path>
         </svg>
            {% include 'front/annonce/_returnSearch.html.twig' %}
            <h1 class="hero__title">{{ annonce.title|raw }} - {{ annonce.ville|raw }}</h1>
            <div class="hero__details">
              <span class="hero__detail">
                <span class="hero__wrapper-svg">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-currency-euro" viewBox="0 0 16 16">
                <path d="M4 9.42h1.063C5.4 12.323 7.317 14 10.34 14c.622 0 1.167-.068 1.659-.185v-1.3c-.484.119-1.045.17-1.659.17-2.1 0-3.455-1.198-3.775-3.264h4.017v-.928H6.497v-.936q-.002-.165.008-.329h4.078v-.927H6.618c.388-1.898 1.719-2.985 3.723-2.985.614 0 1.175.05 1.659.177V2.194A6.6 6.6 0 0 0 10.341 2c-2.928 0-4.82 1.569-5.244 4.3H4v.928h1.01v1.265H4v.928z"/>
              </svg>
              </span>
              {{ annonce.loyer|raw|round }} € / mois</span>
              <span class="hero__detail">
                <span class="hero__wrapper-svg">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pen" viewBox="0 0 16 16">
                  <path d="m13.498.795.149-.149a1.207 1.207 0 1 1 1.707 1.708l-.149.148a1.5 1.5 0 0 1-.059 2.059L4.854 14.854a.5.5 0 0 1-.233.131l-4 1a.5.5 0 0 1-.606-.606l1-4a.5.5 0 0 1 .131-.232l9.642-9.642a.5.5 0 0 0-.642.056L6.854 4.854a.5.5 0 1 1-.708-.708L9.44.854A1.5 1.5 0 0 1 11.5.796a1.5 1.5 0 0 1 1.998-.001m-.644.766a.5.5 0 0 0-.707 0L1.95 11.756l-.764 3.057 3.057-.764L14.44 3.854a.5.5 0 0 0 0-.708z"/>
                </svg>
                </span>
                DPE : {{ annonce.dpe|raw }}</span>

              <span class="hero__detail">
                <span class="hero__wrapper-svg">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-moon-stars" viewBox="0 0 16 16">
                <path d="M6 .278a.77.77 0 0 1 .08.858 7.2 7.2 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277q.792-.001 1.533-.16a.79.79 0 0 1 .81.316.73.73 0 0 1-.031.893A8.35 8.35 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.75.75 0 0 1 6 .278M4.858 1.311A7.27 7.27 0 0 0 1.025 7.71c0 4.02 3.279 7.276 7.319 7.276a7.32 7.32 0 0 0 5.205-2.162q-.506.063-1.029.063c-4.61 0-8.343-3.714-8.343-8.29 0-1.167.242-2.278.681-3.286"/>
                <path d="M10.794 3.148a.217.217 0 0 1 .412 0l.387 1.162c.173.518.579.924 1.097 1.097l1.162.387a.217.217 0 0 1 0 .412l-1.162.387a1.73 1.73 0 0 0-1.097 1.097l-.387 1.162a.217.217 0 0 1-.412 0l-.387-1.162A1.73 1.73 0 0 0 9.31 6.593l-1.162-.387a.217.217 0 0 1 0-.412l1.162-.387a1.73 1.73 0 0 0 1.097-1.097zM13.863.099a.145.145 0 0 1 .274 0l.258.774c.115.346.386.617.732.732l.774.258a.145.145 0 0 1 0 .274l-.774.258a1.16 1.16 0 0 0-.732.732l-.258.774a.145.145 0 0 1-.274 0l-.258-.774a1.16 1.16 0 0 0-.732-.732l-.774-.258a.145.145 0 0 1 0-.274l.774-.258c.346-.115.617-.386.732-.732z"/>
              </svg>
              </span>
              {{ annonce.nombreChambres|raw }} chambre{% if  annonce.nombreChambres > 1%}s{% endif %}</span>

            </div>
            <div class="hero__short-description">            
              {{ annonce.descriptionCourte|raw            
              }}             

            </div>
          
          </div>
          <div class="hero__contact__thumbnails">
            {% include 'front/annonce/_sliderThumbnails.html.twig' %}
            <div class="hero__contact">
              <a href="" class="hero__btn btn">INTÉRESSÉ PAR CE BIEN ?</a>
            </div> 
          </div>

          <div class="hero__description">
            <svg class="hero__svg-description " xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 550">
             <defs>
                <linearGradient id="descriptionGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#173B5F" />
                    <stop offset="100%" stop-color="#2D638A" />
                </linearGradient>
                <filter id="shadow" x="-50%" y="-50%" width="200%" height="200%">
              <feDropShadow dx="0" dy="8" stdDeviation="6"
                            flood-color="#000" flood-opacity="0.2"/>
             </filter>                
            </defs>


          <path fill="url(#descriptionGradient)" d="M 0 0 H 241 C 328 67 528 23 728 0 V 360  C 300 360 200 360 0 360 C 0 300 0 200 0 0 Z"></path>
         </svg>
              <h2 class="hero__subtitle">
                {{annonce.type.value|raw|capitalize}} - {{annonce.ville|raw}}</h2>
              <div class="hero__text-description">
                {{ annonce.description|raw }}

              </div>
            </div>
    </section>
    <section class="form">
      {% include 'front/modal/index.html.twig' %}      

      {% if form is defined %}

        {{ form_start(form, {
          'attr': 
            {class: 'form__form',
            action: path('app_front_ajax_form_annonce'),
            method: 'POST'}
            }) }}

        <h2 class="form__title">CE BIEN VOUS INTÉRESSE ? CONTACTEZ NOUS</h2>

        <div class="form__fieldset">
       
          {{ form_widget(form.prenom) }}
          {{ form_widget(form.nom) }}
          {{ form_widget(form.email) }}
          {{ form_widget(form.telephone) }}

        </div>

        <div class="form__wrapper-message">
          {{ form_widget(form.message) }}
        </div>
         <div class="form__accordion-days">
        <h3 aria-expanded="false" aria-controls="annonce-days" class="form__title-days">Vos disponibilités</h3>
      </div>

      <div class="form__days" id="annonce-days">
          {% for day in ['mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'] %}

            <div class="form__days-hours">
                <div class="form__day">
                  {{ form_label(attribute(form, day)) }}
                  {{ form_widget(attribute(form, day)) }}
                </div>
                {% for hour in ['morning', 'afternoon'] %}
                  <div class="form__hours">
                      {{ form_label(attribute(form, day ~ '_' ~ hour)) }}
                      {{ form_widget(attribute(form, day ~ '_' ~ hour)) }}
                  </div>
               {% endfor %}
            </div>
          {% endfor %}

        </div>
        <button type="submit" class="form__submit btn">
                 Contactez nous
        </button>

        {{ form_end(form) }}

      {% endif %}
      
    </section>
    

{% endblock %}